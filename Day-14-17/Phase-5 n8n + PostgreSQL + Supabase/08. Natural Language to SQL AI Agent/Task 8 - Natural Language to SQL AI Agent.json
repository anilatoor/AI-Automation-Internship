        528
      ],
      "credentials": {
        "openAiApi": {
          "id": "lyXOraZG20gRiyL7",
          "name": "Phase5 OpenAI"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let sql = '';\ntry {\n  sql = JSON.parse($input.first().json.output).sql.trim();\n} catch (e) {\n  sql = '';\n}\n\n// Guardrail: allow-list check, not just a prompt instruction.\nconst forbidden = /\\b(drop|delete|truncate|update|insert|alter|grant|revoke)\\b/i;\nconst isSelectOnly = /^select\\b/i.test(sql) && !forbidden.test(sql);\n\nreturn [{ json: { sql, isSelectOnly, question: $('Webhook - Question In').first().json.body.question } }];"
      },
      "id": "4a4b4c4d-0004-4000-8000-000000000004",
      "name": "Validate SQL is Read-Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
