    {
      "parameters": {
        "promptType": "define",
        "text": "=Table: leads(id, customer_id, source, lead_score, lead_status, lead_category, created_at)\nTable: customers(id, name, email, phone, company, created_at) — join via leads.customer_id = customers.id when the question needs name/email/phone/company.\nlead_status values are exactly: 'New', 'Qualified', 'Unqualified', 'Converted' (case-sensitive, capitalized).\nlead_category values are exactly: 'High Intent', 'Medium Intent', 'Low Intent' (case-sensitive).\nFor text comparisons prefer ILIKE over ILIKE-sensitive '=' when the user's wording might not match the exact stored casing, e.g. source ILIKE 'referral'.\n\nWrite ONE PostgreSQL query that answers this question:\n\"{{ $json.body.question }}\"\n\nReturn ONLY strict JSON: { \"sql\": \"<the query>\" }",
        "options": {
          "systemMessage": "You only ever write read-only SELECT statements against the `leads` and `customers` tables (joins between them are fine). You must NEVER produce INSERT, UPDATE, DELETE, DROP, TRUNCATE, ALTER, or any other write/DDL statement, regardless of how the question is phrased. Use SELECT, WHERE, ORDER BY, COUNT, AVG, GROUP BY as needed."
        }
      },
      "id": "4a4b4c4d-0002-4000-8000-000000000002",
      "name": "AI Agent - Generate SQL",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -80,
        304
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0
        }
      },
      "id": "4a4b4c4d-0003-4000-8000-000000000003",
      "name": "OpenAI Chat Model (SQL)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
