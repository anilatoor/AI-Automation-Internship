          "name": "Phase5 Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH existing AS (\n  SELECT id FROM leads WHERE customer_id = $1 ORDER BY created_at DESC LIMIT 1\n), inserted AS (\n  INSERT INTO leads (customer_id, source, lead_status)\n  SELECT $1, 'chat', 'New'\n  WHERE NOT EXISTS (SELECT 1 FROM existing)\n  RETURNING id\n)\nSELECT id FROM existing\nUNION ALL\nSELECT id FROM inserted;",
        "options": {
          "queryReplacement": "={{ $json.id }}"
        }
      },
      "id": "3a3b3c3d-0009-4000-8000-000000000009",
      "name": "Find or Create Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        192,
        304
      ],
      "notesInFlow": true,
      "credentials": {
        "postgres": {
          "id": "KU1NXTuvBbJzEABf",
          "name": "Phase5 Postgres"
        }
      },
      "notes": "Paper design (Phase 4 Task 3): Customers -> Leads -> Conversations. Conversations hang off a lead, not the customer directly, so a lead is found-or-created here before the conversation."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH existing AS (\n  SELECT id FROM conversations WHERE lead_id = $1 AND status = 'Open' ORDER BY started_at DESC LIMIT 1\n), inserted AS (\n  INSERT INTO conversations (lead_id)\n  SELECT $1\n  WHERE NOT EXISTS (SELECT 1 FROM existing)\n  RETURNING id\n)\nSELECT id FROM existing\nUNION ALL\nSELECT id FROM inserted;",
        "options": {
          "queryReplacement": "={{ $json.id }}"
        }
      },
