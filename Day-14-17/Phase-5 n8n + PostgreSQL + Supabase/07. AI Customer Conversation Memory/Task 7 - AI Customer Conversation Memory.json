      "id": "3a3b3c3d-0004-4000-8000-000000000004",
      "name": "Retrieve Previous Messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        624,
        304
      ],
      "alwaysOutputData": true,
      "notesInFlow": true,
      "credentials": {
        "postgres": {
          "id": "KU1NXTuvBbJzEABf",
          "name": "Phase5 Postgres"
        }
      },
      "notes": "alwaysOutputData: true — a brand-new conversation legitimately has 0 previous messages; without this the node emits no items and the whole execution silently stops here instead of continuing to generate a first reply."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Conversation history (from the database, not model memory):\n{{ $('Retrieve Previous Messages').all().filter(i => i.json.sender).map(i => i.json.sender + ': ' + i.json.message).join('\\n') || '(no previous messages)' }}\n\nCurrent customer message: {{ $('Webhook - Chat Message In').item.json.message }}\n\nAnswer using ONLY facts present in the conversation history above or the current message. If asked something not covered there (e.g. their name, before they've given it), say you don't have that information yet.",
        "options": {
          "systemMessage": "You are a customer support agent. Your only memory is the conversation history passed to you each turn - you must not claim to remember anything not explicitly shown there."
        }
      },
      "id": "3a3b3c3d-0005-4000-8000-000000000005",
      "name": "AI Agent - Generate Response",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        784,
        304
      ],
      "executeOnce": true,
      "notesInFlow": true,
      "notes": "executeOnce: true — \"Retrieve Previous Messages\" emits one item per DB row (0, 1, or many). The prompt already aggregates all of them via $(...).all(), so this node (and everything downstream: saving/syncing messages, responding) must run exactly once per request, not once per history row."
    },
