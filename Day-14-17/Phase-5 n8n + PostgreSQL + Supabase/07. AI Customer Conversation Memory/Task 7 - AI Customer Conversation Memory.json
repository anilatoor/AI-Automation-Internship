    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH existing AS (\n  SELECT id FROM customers WHERE name = $1 LIMIT 1\n), inserted AS (\n  INSERT INTO customers (name, email, phone)\n  SELECT $1, $2, $3\n  WHERE NOT EXISTS (SELECT 1 FROM existing)\n  RETURNING id\n)\nSELECT id FROM existing\nUNION ALL\nSELECT id FROM inserted;",
        "options": {
          "queryReplacement": "={{ $json.name }},{{ $json.email }},{{ $json.phone }}"
        }
      },
      "id": "3a3b3c3d-0002-4000-8000-000000000002",
      "name": "Find or Create Customer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
