      "id": "5a5b5c5d-0001-4000-8000-000000000001",
      "name": "Schedule - Every Morning 8AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -256,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    COUNT(*) AS total_leads,\n    COUNT(*) FILTER (WHERE created_at >= CURRENT_DATE) AS new_leads_today,\n    COUNT(*) FILTER (WHERE lead_status = 'Qualified') AS qualified_leads,\n    COUNT(*) FILTER (WHERE lead_status = 'Converted') AS converted_leads,\n    ROUND(AVG(lead_score), 2) AS avg_lead_score,\n    ROUND(100.0 * COUNT(*) FILTER (WHERE lead_status = 'Converted') / NULLIF(COUNT(*), 0), 1) AS conversion_rate_pct\nFROM leads;",
        "options": {}
      },
      "id": "5a5b5c5d-0002-4000-8000-000000000002",
      "name": "Query Headline Metrics (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -48,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "KU1NXTuvBbJzEABf",
          "name": "Phase5 Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT source, COUNT(*) AS count FROM leads GROUP BY source ORDER BY count DESC LIMIT 1;",
        "options": {}
      },
      "id": "5a5b5c5d-0003-4000-8000-000000000003",
      "name": "Query Top Lead Source",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        192,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "KU1NXTuvBbJzEABf",
          "name": "Phase5 Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.name, l.source, l.lead_score, l.lead_status FROM leads l JOIN customers c ON c.id = l.customer_id ORDER BY l.lead_score DESC LIMIT 5;",
        "options": {}
      },
      "id": "5a5b5c5d-0004-4000-8000-000000000004",
      "name": "Query Top 5 Leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        400,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "KU1NXTuvBbJzEABf",
          "name": "Phase5 Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const metrics = $('Query Headline Metrics (Postgres)').first().json;\nconst topSource = $('Query Top Lead Source').first().json;\nconst top5 = $('Query Top 5 Leads').all().map(i => i.json);\n\nreturn [{\n  json: {\n    ...metrics,\n    top_source: topSource?.source ?? 'N/A',\n    top_source_count: topSource?.count ?? 0,\n    top_5_leads: top5\n  }\n}];"
      },
      "id": "5a5b5c5d-0005-4000-8000-000000000005",
      "name": "Combine Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short daily lead report from this data:\n{{ JSON.stringify($json, null, 2) }}\n\nFormat like this EXACTLY, plain text only — no markdown, no asterisks, no bullet points, no headers:\n📊 Daily Lead Report\n────────────────────\nTotal Leads: <n>\nQualified: <n>\nConverted: <n>\nConversion Rate: <n>%\nTop Source: <source>\n\n💡 Observation:\n<one or two sentence business insight comparing sources/scores>",
        "options": {
          "systemMessage": "Output plain text only. Never use markdown syntax (no **, no #, no -, no *) — this text is sent verbatim into a Slack message and a plain-text email, both of which would show literal asterisks/hashes instead of formatting."
        }
      },
