    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst required = ['name', 'email'];\nconst errors = required.filter((f) => !body[f] || String(body[f]).trim() === '');\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    name: body.name,\n    email: body.email,\n    phone: body.phone ?? null,\n    company: body.company ?? null,\n    message: body.message ?? null,\n    source: body.source ?? 'Unknown'\n  }\n}];"
      },
      "id": "1a1b1c1d-0002-4000-8000-000000000002",
      "name": "Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        304
      ]
    },
    {
      "parameters": {
