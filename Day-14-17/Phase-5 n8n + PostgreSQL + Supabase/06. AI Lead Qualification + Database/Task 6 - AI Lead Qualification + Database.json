    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a B2B lead qualification analyst.\nAnalyze this lead and return ONLY strict JSON, no prose:\n{\n  \"lead_score\": <integer 0-100>,\n  \"lead_status\": <\"New\" | \"Qualified\" | \"Unqualified\">,\n  \"lead_category\": <\"High Intent\" | \"Medium Intent\" | \"Low Intent\">\n}\n\nLead:\nName: {{ $json.name }}\nCompany: {{ $json.company }}\nSource: {{ $json.source }}\nMessage: {{ $json.message }}",
        "options": {
          "systemMessage": "Score based on message urgency/intent, company presence, and source quality (Referral/LinkedIn score higher than generic form fills)."
        }
      },
      "id": "2a2b2c2d-0002-4000-8000-000000000002",
      "name": "AI Agent - Analyze Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -48,
        304
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "2a2b2c2d-0003-4000-8000-000000000003",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        -48,
        528
      ],
      "credentials": {
        "openAiApi": {
          "id": "lyXOraZG20gRiyL7",
          "name": "Phase5 OpenAI"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Webhook - Incoming Lead').first().json.body;\nlet analysis;\ntry {\n  analysis = JSON.parse($input.first().json.output ?? $input.first().json.text);\n} catch (e) {\n  analysis = { lead_score: 0, lead_status: 'New', lead_category: 'Unscored' };\n}\nreturn [{\n  json: {\n    ...lead,\n    lead_score: analysis.lead_score,\n    lead_status: analysis.lead_status,\n    lead_category: analysis.lead_category,\n    ai_analysis: JSON.stringify(analysis)\n  }\n}];"
      },
      "id": "2a2b2c2d-0004-4000-8000-000000000004",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH existing AS (\n  SELECT id FROM customers WHERE email = $1 LIMIT 1\n), inserted AS (\n  INSERT INTO customers (name, email, phone, company)\n  SELECT $2, $1, $3, $4\n  WHERE NOT EXISTS (SELECT 1 FROM existing)\n  RETURNING id\n)\nSELECT id FROM existing\nUNION ALL\nSELECT id FROM inserted;",
        "options": {
          "queryReplacement": "={{ $('Webhook - Incoming Lead').item.json.email }},{{ $('Webhook - Incoming Lead').item.json.name }},{{ $('Webhook - Incoming Lead').item.json.phone }},{{ $('Webhook - Incoming Lead').item.json.company }}"
        }
      },
