      "parameters": {
        "jsCode": "const body = $json.body || $json;\nlet a = {}; let isVapi = false; let toolCallId = null;\nif (body.message && body.message.toolCalls) {\n  isVapi = true;\n  const call = body.message.toolCalls[0];\n  toolCallId = call.id;\n  let args = call.function ? call.function.arguments : {};\n  if (typeof args === 'string') { try { args = JSON.parse(args); } catch (e) { args = {}; } }\n  a = args;\n} else {\n  a = body;\n}\nreturn {\n  name: a.name || '', phone: a.phone || '', city: a.city || '',\n  product_interest: a.product_interest || '', budget_pkr: Number(a.budget_pkr || 0),\n  intent: (a.purchase_intent || a.intent || 'browsing') === 'ready_to_buy' ? 'ready' : (a.purchase_intent || a.intent || 'browsing'),\n  source: a.channel || a.source || 'website',\n  isVapi, toolCallId\n};"
      },
