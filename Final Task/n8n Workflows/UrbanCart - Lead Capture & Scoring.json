      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst readyToBuy = (item.intent || '').toLowerCase() === 'ready';\nconst hasBudget = Number(item.budget_pkr) > 0;\nlet score = 'Cold';\nif (readyToBuy && hasBudget) score = 'Hot';\nelse if (readyToBuy || hasBudget) score = 'Warm';\nitem.score = score;\nreturn item;"
      },
