    {
      "parameters": {
        "jsCode": "// Turn one spreadsheet row into one readable sentence for RAG\nconst r = $json;\nconst stock = Number(r.Stock) > 0 ? `In stock (${r.Stock})` : 'Out of stock';\nconst warranty = Number(r.Warranty_Months) > 0 ? `${r.Warranty_Months} month warranty` : 'No warranty';\nconst line = `Product: ${r.Name} | Category: ${r.Category} | Price: Rs. ${r.Price_PKR} | ${stock} | ${warranty} | ${r.Description || ''}`.trim();\nreturn { json: { kb_text: line, _file_id: $('Download XLSX').item.json.id, _file_name: $('Download XLSX').item.json.name } };"
      },
      "id": "10de2bc0-799e-4d41-bcc8-ad72fcba7453",
