      "typeVersion": 4.5,
      "position": [
        752,
        528
      ]
    },
    {
      "parameters": {
        "toolDescription": "Save a sales lead once the customer has shown buying interest and you have at least their name, phone and product interest.",
        "method": "POST",
        "url": "https://anila092.app.n8n.cloud/webhook/urbancart-lead-capture",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"name\": $fromAI('name', 'customer full name', 'string'), \"phone\": $('Normalize Message').item.json.phone, \"product_interest\": $fromAI('product_interest', 'the product the customer is interested in', 'string'), \"budget_pkr\": $fromAI('budget_pkr', 'approximate budget in PKR, 0 if unknown', 'number'), \"city\": $fromAI('city', 'customer city, empty string if unknown', 'string'), \"purchase_intent\": $fromAI('purchase_intent', 'either ready or browsing', 'string'), \"channel\": $('Normalize Message').item.json.channel } }}",
        "options": {}
      },
      "id": "5bd23bf5-3cbf-4ea7-8fb4-93423f8b0a38",
      "name": "capture_lead",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.5,
      "position": [
        1040,
        528
      ]
    },
    {
      "parameters": {
        "toolDescription": "Hand off to a human immediately for damaged products, complicated refunds, angry or frustrated customers, or an explicit request to speak to a human.",
        "method": "POST",
        "url": "https://anila092.app.n8n.cloud/webhook/urbancart-escalate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"name\": $('Normalize Message').item.json.name, \"phone\": $('Normalize Message').item.json.phone, \"category\": $fromAI('category', 'one of: damaged_product, refund, angry_customer, low_confidence, other', 'string'), \"summary\": $fromAI('summary', 'short summary of the issue for the support team', 'string'), \"order_code\": $fromAI('order_code', 'related order code if mentioned, empty string otherwise', 'string'), \"channel\": $('Normalize Message').item.json.channel } }}",
        "options": {}
      },
      "id": "7026d2e6-1629-4bf7-9cc7-a95ce21a9536",
