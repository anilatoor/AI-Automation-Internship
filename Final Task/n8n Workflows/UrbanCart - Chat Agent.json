    {
      "parameters": {
        "toolDescription": "Look up a UrbanCart order by its code (format UC-##### e.g. UC-10452) and return its live status and expected delivery date.",
        "method": "POST",
        "url": "https://anila092.app.n8n.cloud/webhook/urbancart-order-lookup",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"order_code\": $fromAI('order_code', 'the order code the customer mentioned, e.g. UC-10452', 'string') } }}",
        "options": {}
      },
      "id": "028e435d-ac31-4e2c-bfb4-da4037433ec0",
      "name": "lookup_order",
